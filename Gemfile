source "https://rubygems.org"

# GitHub Pages と同じバージョンの Jekyll / プラグインを使う
gem "github-pages", "~> 232", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
  gem "jemoji"
end

# Ruby 3.0 以降では webrick が標準添付されないため `jekyll serve` に必要
gem "webrick", "~> 1.8"
